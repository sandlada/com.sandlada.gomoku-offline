# Cloudflare Pages headers. Vite copies this file to dist/ as-is.
# Security headers for all responses (no Cache-Control here so SW/manifest rules below stay authoritative).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: interest-cohort=()

# Vite hashed assets: safe to cache aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Entry + service worker + manifest must revalidate, otherwise PWA updates/offline cache go stale.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/workbox-*.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Unversioned icons: short cache since content can change without a filename change.
/icon-*.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/pwa-icon.svg
  Cache-Control: public, max-age=86400
/icons.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og-cover.png
  Cache-Control: public, max-age=86400
